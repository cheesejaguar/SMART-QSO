// SQSO-HW-DIAG-001 B1: system overview (baseline: docs/BASELINE_PARAMETERS.md Rev E; board build-to designs
// hardware/electrical/{eps,obc,rf}/*_BOARD_DESIGN.md; pins hardware/electrical/INTERCONNECT.md, SQSO-ICX-001).
// Red = power, blue = data, purple = RF, dashed green = control/enable.
digraph B1 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.3, ranksep=0.55, newrank=true,
         label="B1  SMART-QSO system overview   (SQSO-HW-DIAG-001 Rev B: from the EPS, OBC and RF board build-to designs)\nred power · blue data · purple RF · dashed green control",
         labelloc=t, labeljust=l];
  node  [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=8];

  subgraph cluster_eps {
    label="EPS board (PC/104, SQSO-EPS-BRD-001)"; style=rounded; color="#c62828"; fontcolor="#c62828";
    SA   [label="Solar array: 16 × AZUR 3G30A\n8 strings of 2 cells (4 body faces, 2 wings)", fillcolor="#ffebee"];
    MPPT [label="4 × TPS55340-Q1 trackers\nCV 16.40 V · CC 0.394 A · 0-45 °C"];
    BAT  [label="Battery 4S1P Li-ion 18650\n≈ 3.5 Ah · 14.4 V · ≈ 50 Wh\nBQ76952 AFE + BQ771806 secondary", fillcolor="#ffebee"];
    INH  [label="Power inhibits: deployment switches\nDS1, DS2, DS3 on three rails\nRBF (not counted)", fillcolor="#fff3e0"];
    REG  [label="LMR43620-Q1 bucks, 1.000 MHz synchronised\n3V3_AO · 5V_PA · V_BURN (7.0 V)"];
    LSW  [label="Load switches SW1-SW11 with latch-up trips\nOBC · RADIO · PA · ADCS · VBAT_MTQ · HEATER\nDEPLOY · AntS · GNSS · PAYLOAD + eFuse", fillcolor="#ffebee"];
    SA -> MPPT -> BAT -> INH -> REG -> LSW [color="#c62828", penwidth=1.6];
  }

  OBC [label="OBC board: STM32L4R5ZI (SQSO-OBC-BRD-001)\nFM25V20A FRAM · TPS3850 supervisor · RV-3028 clock\nRust / Embassy flight software", fillcolor="#e3f2fd", penwidth=1.6];
  GSE [label="GSE umbilical\n(integration only)", shape=note, fillcolor="#eeeeee"];

  subgraph cluster_rf {
    label="RF board (SQSO-RF-BRD-001)"; style=rounded; color="#6a1b9a"; fontcolor="#6a1b9a";
    TNC  [label="KISS TNC: STM32L431\nAFSK 1200, full duplex"];
    RX   [label="UHF receiver CC1200 (analog FM)\nBFP640F LNA · SAW · always on\nrequest 435.222-435.778 MHz"];
    TX   [label="VHF exciter LMX2571 + PA RD01MUS3\n145.800-146.000 MHz\n0.5 W nom., 1 W max"];
    XPDR [label="FM transponder repeat path\nCTCSS 67.0 Hz, XPDR_EN heartbeat\n120 s key-down timer"];
  }
  JET  [label="AI payload: Jetson Orin Nano 8 GB\non carrier · 7 W mode · ≤ 8 W\n≤ 10 min bursts, sunlit, SOC ≥ 55 %", fillcolor="#e8f5e9"];
  ADCS [label="ADCS on the OBC board: 3 × CR0002 rods (DRV8876)\nRM3100 magnetometer · M-G370PDT0 gyro (BMI088 spare)\n6 sun sensors (ADS7138)", fillcolor="#fffde7"];
  GNSS [label="GNSS: SkyFox piNAV-NG/FM\n+ ZENITH V3a patch", fillcolor="#fffde7"];
  DEP  [label="Deployables\nwings: 2 resistors each, 4 burn lines\nISIS AntS by I2C · hinge sense", fillcolor="#fff3e0"];
  ANTU [label="UHF ¼-λ monopole\n≈ 0.17 m", shape=invtriangle, fillcolor="#f3e5f5"];
  ANTV [label="VHF ¼-λ monopoles along ±X\n≈ 0.5 m", shape=invtriangle, fillcolor="#f3e5f5"];

  {rank=same; OBC; GSE}
  {rank=same; TNC; JET; ADCS; GNSS; DEP}
  {rank=same; ANTU; ANTV}

  // Power from the load switches
  LSW -> OBC  [label="3V3_OBC (SW10)", color="#c62828"];
  LSW -> TNC  [label="RADIO 3V3", color="#c62828"];
  LSW -> TX   [label="PA 5 V", color="#c62828"];
  LSW -> JET  [label="VBAT (SW1 + eFuse)", color="#c62828"];
  LSW -> ADCS [label="3V3_ADCS · VBAT_MTQ", color="#c62828"];
  LSW -> GNSS [label="3V3_GNSS", color="#c62828"];
  LSW -> DEP  [label="V_BURN · 3V3_ANTS", color="#c62828"];

  // Control
  OBC -> LSW [label="enables, burn, EOL lines", color="#2e7d32", style=dashed, constraint=false];
  OBC -> REG [label="I2C2: INA228 0x40/0x44, controller 0x48", color="#1565c0", dir=both, constraint=false];

  // Data
  OBC -> TNC  [label="USART2", color="#1565c0", dir=both];
  OBC -> JET  [label="USART1 (isolated)", color="#1565c0", dir=both];
  OBC -> ADCS [label="SPI2 · SPI3 · I2C4 · TIM1", color="#1565c0", dir=both];
  OBC -> GNSS [label="LPUART1 · 1PPS", color="#1565c0", dir=both];
  OBC -> DEP  [label="burn / I2C2 / sense", color="#2e7d32", style=dashed, dir=both];
  GSE -> OBC  [label="USART3 · SWD", color="#1565c0", dir=both];

  // RF (declared top-down for layout; arrows show signal direction)
  {rank=same; RX; XPDR; TX}
  TNC -> TX  [color="#6a1b9a", label="AFSK 1200"];
  TNC -> RX  [color="#6a1b9a", dir=back, label="demodulator samples"];
  RX -> XPDR [color="#6a1b9a", style=dotted, label="audio"];
  XPDR -> TX [color="#6a1b9a", style=dotted];
  TX -> ANTV [color="#6a1b9a", penwidth=1.6];
  RX -> ANTU [color="#6a1b9a", penwidth=1.6, dir=back, label="RX filter"];
}
