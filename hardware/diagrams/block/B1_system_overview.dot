// SQSO-HW-DIAG-001 B1: system overview (baseline: docs/BASELINE_PARAMETERS.md)
// Red = power, blue = data, purple = RF, dashed green = control/enable,
// grey dashed box = part not selected (TBD).
digraph B1 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.3, ranksep=0.55, newrank=true,
         label="B1  SMART-QSO system overview   (SQSO-HW-DIAG-001, preliminary: dashed = part not selected)\nred power · blue data · purple RF · dashed green control",
         labelloc=t, labeljust=l];
  node  [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=8];

  subgraph cluster_eps {
    label="EPS board (PC/104)"; style=rounded; color="#c62828"; fontcolor="#c62828";
    SA   [label="Solar array: 16 × AZUR 3G30A\n8 strings of 2 cells (4 body faces, 2 wings)", fillcolor="#ffebee"];
    MPPT [label="MPPT / charger (TBD)\nboost to 12.0–16.8 V", style="rounded,dashed,filled"];
    BAT  [label="Battery 4S1P Li-ion 18650\n≈ 3.5 Ah · 14.4 V · ≈ 50 Wh\nBMS BQ76920 or eq. (TBD)", fillcolor="#ffebee"];
    INH  [label="Power inhibits\ndeployment switches DS1, DS2\n+ 3rd inhibit (TBD) · RBF (not counted)", fillcolor="#fff3e0"];
    REG  [label="Regulators (TBD, 4S input)\n3V3_AO · 5V · VBAT", style="rounded,dashed,filled"];
    LSW  [label="Load switches\nPAYLOAD · RADIO · PA · ADCS · HEATER · DEPLOY · GNSS", fillcolor="#ffebee"];
    SA -> MPPT -> BAT -> INH -> REG -> LSW [color="#c62828", penwidth=1.6];
  }

  OBC [label="OBC: STM32L4R5ZI\nFM25V20A FRAM · IWDG\nRust / Embassy flight software", fillcolor="#e3f2fd", penwidth=1.6];
  GSE [label="GSE umbilical\n(integration only)", shape=note, fillcolor="#eeeeee"];

  subgraph cluster_rf {
    label="RF board"; style=rounded; color="#6a1b9a"; fontcolor="#6a1b9a";
    TNC  [label="KISS TNC (TBD)\nfull duplex", style="rounded,dashed,filled"];
    RX   [label="UHF receiver (TBD)\n435–438 MHz, always on", style="rounded,dashed,filled"];
    TX   [label="VHF TX + PA (TBD)\n145.800–146.000 MHz\n0.5 W nom., 1 W max", style="rounded,dashed,filled"];
    XPDR [label="FM transponder\nU/V, CTCSS-gated", style="rounded,dashed,filled"];
  }
  JET  [label="AI payload: Jetson Orin Nano 8 GB\non carrier · 7 W mode · ≤ 8 W\n≤ 120 s bursts, sunlit, SOC ≥ 55 %", fillcolor="#e8f5e9"];
  ADCS [label="ADCS: 3 magnetorquers\nmagnetometer · gyro\nsun sensors (parts TBD)", fillcolor="#fffde7"];
  GNSS [label="GNSS: SkyFox piNAV-NG/FM\n+ ZENITH V3a patch", fillcolor="#fffde7"];
  DEP  [label="Deployables\nburn wires: 2 antennas, 2 wings\nsense switches", fillcolor="#fff3e0"];
  ANTU [label="UHF ¼-λ monopole\n≈ 0.17 m", shape=invtriangle, fillcolor="#f3e5f5"];
  ANTV [label="VHF ¼-λ monopole\n≈ 0.5 m", shape=invtriangle, fillcolor="#f3e5f5"];

  {rank=same; OBC; GSE}
  {rank=same; TNC; JET; ADCS; GNSS; DEP}
  {rank=same; ANTU; ANTV}

  // Power from the load switches
  LSW -> OBC  [label="3V3_AO", color="#c62828"];
  LSW -> TNC  [label="RADIO", color="#c62828"];
  LSW -> TX   [label="PA 5 V", color="#c62828"];
  LSW -> JET  [label="5 V", color="#c62828"];
  LSW -> ADCS [label="3V3", color="#c62828"];
  LSW -> GNSS [label="3V3", color="#c62828"];
  LSW -> DEP  [label="VBAT", color="#c62828"];

  // Control
  OBC -> LSW [label="enables", color="#2e7d32", style=dashed, constraint=false];
  OBC -> REG [label="I2C2 telemetry", color="#1565c0", dir=both, constraint=false];

  // Data
  OBC -> TNC  [label="USART2", color="#1565c0", dir=both];
  OBC -> JET  [label="USART1", color="#1565c0", dir=both];
  OBC -> ADCS [label="I2C4", color="#1565c0", dir=both];
  OBC -> GNSS [label="UART (TBD)", color="#1565c0", dir=back];
  OBC -> DEP  [label="burn / sense", color="#2e7d32", style=dashed, dir=both];
  GSE -> OBC  [label="USART3", color="#1565c0", dir=both];

  // RF (declared top-down for layout; arrows show signal direction)
  {rank=same; RX; XPDR; TX}
  TNC -> TX  [color="#6a1b9a", label="AFSK 1200"];
  TNC -> RX  [color="#6a1b9a", dir=back, label="frames"];
  RX -> XPDR [color="#6a1b9a", style=dotted, label="audio"];
  XPDR -> TX [color="#6a1b9a", style=dotted];
  TX -> ANTV [color="#6a1b9a", penwidth=1.6];
  RX -> ANTU [color="#6a1b9a", penwidth=1.6, dir=back, label="RX filter"];
}
