// SQSO-HW-DIAG-001 B2: power distribution. Values: BASELINE §5, PDU_DESIGN.md
// (current limits, TBR: other documents differ), firmware gpio.rs/adc.rs (pins).
digraph B2 {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.25, ranksep=0.5, newrank=true,
         label="B2  Power distribution   (SQSO-HW-DIAG-001, preliminary)\ndashed = part not selected · limits from PDU_DESIGN.md, TBR · enable pins from software/rust/firmware/src/gpio.rs (provisional)",
         labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#c62828"];

  subgraph cluster_gen {
    label="Generation"; style=rounded; color="#c62828";
    SA [label="8 strings of 2 cells (AZUR 3G30A)\nbody ±X, ±Y: 1 string each\nwings W1, W2: 2 strings each (front/back)", fillcolor="#ffebee"];
    BD [label="8 blocking / ideal diodes\n(1 per string)"];
    SA -> BD;
    MPPT [label="MPPT / BCR (TBD)\nboost 4.2–4.8 V → 12.0–16.8 V\ncharge ≤ 0.40 A, 0–45 °C only", style="rounded,dashed,filled"];
    PASS [label="EOL passivation latch\nnon-resettable (TBD)", style="rounded,dashed,filled", fillcolor="#fff3e0"];
    BD -> MPPT [label="8 strings, Vmp 4.2–4.8 V, Imp 0.50 A"];
    MPPT -> PASS [label="charge path"];
  }

  subgraph cluster_bat {
    label="Battery pack"; style=rounded; color="#c62828";
    BAT [label="4S1P Li-ion 18650\n12.0–16.8 V · ≈ 3.5 Ah", fillcolor="#ffebee"];
    BMS [label="BMS BQ76920 or eq. (TBD)\nOV 4.25 V · UV 2.8 V · OC 5 A\nbalancing · HW comparator backup", style="rounded,dashed,filled"];
    FUSE [label="Pack fuse (non-resettable)\n+ PTC", fillcolor="#ffebee"];
    BAT -> BMS -> FUSE;
  }
  PASS -> BAT [label="charge"];

  subgraph cluster_inh {
    label="Inhibits (CDS 2.3.7/2.3.8: ≥ 3 physical; RBF does not count)"; style=rounded; color="#ef6c00";
    DS1 [label="DS1 deployment switch\n(VBAT+ path)", fillcolor="#fff3e0"];
    DS2 [label="DS2 deployment switch\n(VBAT− path)", fillcolor="#fff3e0"];
    INH3 [label="Inhibit 3 (TBD)\nplacement and part open", style="rounded,dashed,filled", fillcolor="#fff3e0"];
    RBF [label="RBF pin\n(battery disconnect, −Z face)", fillcolor="#eeeeee"];
  }
  FUSE -> RBF -> DS1 -> DS2 -> INH3;

  VBAT [label="VBAT bus\n12.0–16.8 V", shape=cds, fillcolor="#ffcdd2"];
  INH3 -> VBAT;

  subgraph cluster_reg {
    label="Regulators (TBD: none of the documented parts takes a 4S input)"; style=rounded; color="#c62828";
    R33 [label="3V3_AO buck (TBD)\n≥ 0.5 A · always on", style="rounded,dashed,filled"];
    R5  [label="5V buck (TBD)\n≥ 4 A (Jetson 3 A + PA 0.8 A)", style="rounded,dashed,filled"];
  }
  VBAT -> R33; VBAT -> R5;

  subgraph cluster_sw {
    label="Load switches (OBC enable lines; outputs low at reset)"; style=rounded; color="#2e7d32";
    SW1 [label="SW1 PAYLOAD  5V\nPAYLOAD_EN  PB4\n2.0 A nom · 3.5 A trip"];
    SW2 [label="SW2 RADIO (RX + TNC)\nRADIO_EN  PB5\nRF silence removes it"];
    SW3 [label="SW3 PA  5V  (TX-OFF hardware switch)\nRF_TX_EN  PA3, pull-down\n0.5 A nom · 1.0 A trip"];
    SW4 [label="SW4 ADCS  3V3\nADCS_EN  PB6\n0.2 A nom · 0.5 A trip"];
    SW5 [label="SW5 HEATER  VBAT\nHEATER_EN  PD2\n0.3 A nom · 0.5 A trip"];
    SW6 [label="SW6 DEPLOY arm  VBAT\nDEPLOY_EN  PA1\n2.0 A peak"];
    SW7 [label="SW7 GNSS  3V3  latch-up trip\nGNSS_EN  (no pin yet; PE4 proposed)", style="rounded,dashed,filled"];
  }
  R5 -> SW1; R5 -> SW3; R33 -> SW2; R5 -> SW2 [style=dotted, label="if the radio needs 5 V (TBD)"];
  R33 -> SW4; VBAT -> SW5; VBAT -> SW6; R33 -> SW7;

  OBC  [label="OBC + FRAM\n3V3_AO ≈ 50 mA", fillcolor="#e3f2fd"];
  JET  [label="Jetson carrier\nJETSON_PWR PA2 → soft-start gate (4 A)\n≤ 8 W input", fillcolor="#e8f5e9"];
  RXT  [label="UHF RX + KISS TNC", fillcolor="#f3e5f5"];
  PA   [label="VHF TX/PA\nTX_PWR_SEL PE3 (0.5 / 1 W)", fillcolor="#f3e5f5"];
  ADCS [label="ADCS board", fillcolor="#fffde7"];
  HTR  [label="Battery heater 0.5 W\n(NTC × 2 on the pack)", fillcolor="#fffde7"];
  BURN [label="Burn-wire drivers\nANTENNA_BURN PB9 · SOLAR_BURN PB10", fillcolor="#fff3e0"];
  GNSS [label="GNSS piNAV-NG/FM\n125 mW", fillcolor="#fffde7"];
  R33 -> OBC [label="always on"];
  {rank=same; SW1; SW2; SW3; SW4; SW5; SW6; SW7}
  {rank=same; OBC; JET; RXT; PA; ADCS; HTR; BURN; GNSS}
  SW1 -> JET; SW2 -> RXT; SW3 -> PA; SW4 -> ADCS; SW5 -> HTR; SW6 -> BURN; SW7 -> GNSS;

  subgraph cluster_tlm {
    label="Telemetry"; style=rounded; color="#1565c0";
    ADC [label="OBC ADC1 (scale TBR)\nVBATT PC2 · IBATT PC3 · VSOLAR PC4\nISOLAR PC5 · VBUS PB0 · TEMP_BOARD PB1", fillcolor="#e3f2fd"];
    INA [label="INA226 shunts on I2C2\nbattery ±3 A · solar 2 A · 5V 4 A · Jetson 3.5 A", fillcolor="#e3f2fd"];
  }
  VBAT -> ADC [style=dotted, color="#1565c0"];
  VBAT -> INA [style=dotted, color="#1565c0"];
}
