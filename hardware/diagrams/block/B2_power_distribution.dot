// SQSO-HW-DIAG-001 B2: power distribution. Values: BASELINE §4-§5 and the EPS board build-to design
// (hardware/electrical/eps/EPS_BOARD_DESIGN.md, SQSO-EPS-BRD-001 Version B §3-§9); OBC pins from the master allocation
// (hardware/electrical/INTERCONNECT.md, SQSO-ICX-001 §3.1). Limits are nominal (minimum-maximum in SQSO-EPS-BRD-001 §8.3).
digraph B2 {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.25, ranksep=0.5, newrank=true,
         label="B2  Power distribution   (SQSO-HW-DIAG-001 Rev B; EPS board SQSO-EPS-BRD-001 Version B)\nlimits nominal, from SQSO-EPS-BRD-001 §8.3 · OBC enable pins from SQSO-ICX-001 §3.1 · all enables low at OBC reset (100 kΩ pull-downs)",
         labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#c62828"];

  subgraph cluster_gen {
    label="Generation"; style=rounded; color="#c62828";
    SA [label="8 strings of 2 cells (AZUR 3G30A)\nbody ±X, ±Y: 1 string each\nwings W1, W2: 2 strings each (front/back)", fillcolor="#ffebee"];
    BD [label="8 × SMBJ7.0A TVS + LM74700-Q1\nideal diodes (1 per string)"];
    SA -> BD;
    MPPT [label="4 × TPS55340-Q1 boost trackers\n1.000 MHz synchronised, analog MPPT\nCV 16.40 V (4.10 V/cell) · CC 0.394 A\ncharge 0-45 °C only (NTC1 comparators)"];
    PASS [label="EOL charge disconnect F1\nITV4030 three-terminal fuse\nfired only by EOL_ARM PF4 AND EOL_FIRE PG1", fillcolor="#fff3e0"];
    BD -> MPPT [label="8 strings, Vmp 4.2-4.8 V"];
    MPPT -> PASS [label="VTRK"];
  }

  subgraph cluster_bat {
    label="Battery pack and protection (PACK domain)"; style=rounded; color="#c62828";
    BAT [label="4S1P Li-ion 18650\n12.0-16.4 V (16.8 V max) · ≈ 3.5 Ah", fillcolor="#ffebee"];
    FUSE [label="F2 5 A fuse · RT1 PTC\nF3 secondary fuse (BQ771806, 4.35 V/cell)", fillcolor="#ffebee"];
    BMS [label="BQ76952 AFE\nCOV 4.25 V · CUV 2.80 V · OCD 4 A · SCD 10 A\nOTP · latched recharge lockout K1"];
    BAT -> FUSE -> BMS;
  }
  PASS -> PACKP [label="charge"];

  PACKP [label="PACK_P", shape=point, width=0.08];
  BMS -> PACKP;

  subgraph cluster_inh {
    label="Inhibits (CDS 2.3.7/2.3.8: three physical, each switch on its own rail and harness; RBF does not count)"; style=rounded; color="#ef6c00";
    DS2 [label="Inhibit 1: DS2 deployment switch (J16)\nQ6 + Q7 back to back in the pack return\n(PACK_N - GND)", fillcolor="#fff3e0"];
    DS1 [label="Inhibit 2: DS1 deployment switch (J15)\nQ4 high-side P-FET, PACK_P - VB1", fillcolor="#fff3e0"];
    DS3 [label="Inhibit 3: DS3 deployment switch (J17)\nQ5 high-side P-FET, VB1 - VB3\nNO contact holds the trackers' TRK_EN low", fillcolor="#fff3e0"];
    RBF [label="RBF pin, two poles (J14)\nin series with DS2's drive; clamps TRK_EN\n(not counted)", fillcolor="#eeeeee"];
  }
  PACKP -> DS1 -> DS3;
  DS2 -> BAT [style=dashed, label="pack return", dir=back];
  RBF -> DS2 [style=dotted, color="#ef6c00", arrowhead=none];
  DS3 -> MPPT [style=dotted, color="#ef6c00", label="TRK_EN", constraint=false];

  VBAT [label="VBAT bus\n11.2-16.4 V\nhardware load shed < 13.6 V for 5 s\n(SW1, SW3)", shape=cds, fillcolor="#ffcdd2"];
  DS3 -> VBAT;

  subgraph cluster_reg {
    label="Converters (LMR43620-Q1, 42 V input, synchronised to 1.000 MHz)"; style=rounded; color="#c62828";
    R33 [label="U15 3V3_AO buck\n3.3 V ± 2 %, 0.30 A, always on"];
    R5  [label="U16 5V_PA buck\n5.0 V, 0.54 A (PA only)"];
    RB  [label="U17 V_BURN buck\n7.0 V, only with DEPLOY_EN"];
  }
  VBAT -> R33;

  subgraph cluster_sw {
    label="Load switches (OBC enable lines; outputs low at reset)"; style=rounded; color="#2e7d32";
    SW10 [label="SW10 3V3_OBC  0.15 A\nno enable: auto-retry 0.28 s"];
    SW9  [label="SW9 EPS controller  75 mA\nno enable: auto-retry"];
    SW2  [label="SW2 RADIO 3.3 V  0.12 A\nRADIO_EN PB5"];
    SW4  [label="SW4 ADCS sensors 3.3 V  0.30 A\nADCS_EN PB6 (load 0.049 A)"];
    SW7  [label="SW7 GNSS 3.3 V  0.20 A\nGNSS_EN PE5"];
    SW8  [label="SW8 AntS 3.3 V  1.37 A\nDEPLOY_EN PF3"];
    SW3  [label="SW3 PA 5 V  0.99 A (TX-OFF switch)\nRF_TX_EN PA3 AND SHED_N"];
    SW1  [label="SW1 PAYLOAD VBAT  1.99 A\nPAYLOAD_EN PB2 AND SHED_N\n+ U19 eFuse 1.20 A, JETSON_PWR PA2"];
    SW5  [label="SW5 HEATER VBAT  0.148 A\nHEATER_EN PD2 · F4 · 40 °C cutout"];
    SW11 [label="SW11 VBAT_MTQ  0.361 A\nADCS_EN PB6"];
    SW6  [label="SW6 DEPLOY VBAT  1.99 A\nDEPLOY_EN PF3 (master arm)"];
  }
  R33 -> SW10; R33 -> SW9; R33 -> SW2; R33 -> SW4; R33 -> SW7; R33 -> SW8;
  VBAT -> R5; R5 -> SW3;
  VBAT -> SW1; VBAT -> SW5; VBAT -> SW11; VBAT -> SW6; SW6 -> RB;

  OBC  [label="OBC + FRAM\n25-40 mA (3V3_RTC to the RV-3028 always on)", fillcolor="#e3f2fd"];
  EPSC [label="EPS controller MSP430FR2355\nI2C2 0x48", fillcolor="#e3f2fd"];
  RXT  [label="RF board: UHF RX, KISS TNC, exciter\n38 mA", fillcolor="#f3e5f5"];
  ADCS [label="OBC board sensors (W6B)\nown 50-100 mA latch-up switches", fillcolor="#fffde7"];
  GNSS [label="GNSS piNAV-NG/FM\n125 mW", fillcolor="#fffde7"];
  ANTS [label="ISIS AntS\nI2C arm / deploy", fillcolor="#fff3e0"];
  PA   [label="RF board PA RD01MUS3\n1.76 W DC at 0.5 W RF\nTX_PWR_SEL PE3 (0.5 / 1 W)", fillcolor="#f3e5f5"];
  JET  [label="Jetson carrier (VBAT)\n≤ 8 W input", fillcolor="#e8f5e9"];
  HTR  [label="Battery heater 207 Ω\n0.70-1.30 W", fillcolor="#fffde7"];
  MTQ  [label="OBC DRV8876 bridges, 3 × CR0002 rods\n1.16 W, three saturated", fillcolor="#fffde7"];
  BURN [label="4 burn drivers, 0.8 A each, 12 s one-shot\nBURN_W1A PB10 · BURN_W1B PE6\nBURN_W2A PB9 · BURN_W2B PE7\none resistor at a time: 0.67 A at the pack", fillcolor="#fff3e0"];
  {rank=same; SW10; SW9; SW2; SW4; SW7; SW8; SW3; SW1; SW5; SW11; SW6}
  {rank=same; OBC; EPSC; RXT; ADCS; GNSS; ANTS; PA; JET; HTR; MTQ; BURN}
  SW10 -> OBC; SW9 -> EPSC; SW2 -> RXT; SW4 -> ADCS; SW7 -> GNSS; SW8 -> ANTS; SW3 -> PA; SW1 -> JET; SW5 -> HTR; SW11 -> MTQ; RB -> BURN;

  subgraph cluster_tlm {
    label="Telemetry"; style=rounded; color="#1565c0";
    ADC [label="OBC ADC1\nVBATT PC2 (pack / 6) · IBATT PC3 · VSOLAR PC4\nISOLAR PC5 · VBUS PB0 · VJET_RB PA7 · VSW1_RB PA1", fillcolor="#e3f2fd"];
    INA [label="INA228 on I2C2: pack gauge 0x44, array 0x40\nINA3221 × 4, ADS7138, AFE on the controller's bus", fillcolor="#e3f2fd"];
  }
  VBAT -> ADC [style=dotted, color="#1565c0"];
  VBAT -> INA [style=dotted, color="#1565c0"];
}
